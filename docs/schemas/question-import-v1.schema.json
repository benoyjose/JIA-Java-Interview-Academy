{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jia.example/schemas/question-import-v1.schema.json",
  "title": "JIA Question Import Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "questions"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "categorySlug",
          "slug",
          "questionType",
          "difficulty",
          "prompt",
          "answer",
          "explanation",
          "provenance"
        ],
        "properties": {
          "categorySlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "questionType": {
            "enum": [
              "SINGLE_SELECT",
              "MULTI_SELECT",
              "TRUE_FALSE"
            ]
          },
          "difficulty": {
            "enum": [
              "BEGINNER",
              "NOVICE",
              "PROFESSIONAL",
              "EXPERT"
            ]
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "code": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "language",
                  "source"
                ],
                "properties": {
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                }
              }
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          },
          "answer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "correctValues"
            ],
            "properties": {
              "correctValues": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "hint": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceType",
              "sourceDescription"
            ],
            "properties": {
              "sourceType": {
                "enum": [
                  "USER_ORIGINAL",
                  "ADMIN_AUTHORED",
                  "EXTERNAL_REFERENCE"
                ]
              },
              "sourceDescription": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              }
            }
          },
          "changeNote": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "questionType": {
                  "const": "SINGLE_SELECT"
                }
              },
              "required": [
                "questionType"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "answer": {
                  "properties": {
                    "correctValues": {
                      "minItems": 1,
                      "maxItems": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "questionType": {
                  "const": "MULTI_SELECT"
                }
              },
              "required": [
                "questionType"
              ]
            },
            "then": {
              "required": [
                "options"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "questionType": {
                  "const": "TRUE_FALSE"
                }
              },
              "required": [
                "questionType"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "minItems": 2,
                  "maxItems": 2
                },
                "answer": {
                  "properties": {
                    "correctValues": {
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "enum": [
                          "true",
                          "false"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provenance": {
                  "properties": {
                    "sourceType": {
                      "const": "EXTERNAL_REFERENCE"
                    }
                  },
                  "required": [
                    "sourceType"
                  ]
                }
              },
              "required": [
                "provenance"
              ]
            },
            "then": {
              "properties": {
                "provenance": {
                  "required": [
                    "attribution"
                  ],
                  "properties": {
                    "attribution": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
