# Local development only. Never commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/jia
DB_USERNAME=jia
DB_PASSWORD=jia_local_only
SERVER_PORT=8080

# Provider audiences; see docs/EXTERNAL_CONFIGURATION_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SERVICE_ID=

# SMS gateway must accept JSON {to, message} with Bearer authentication
JIA_SMS_ENDPOINT=
JIA_SMS_TOKEN=
# Generate at least 32 random bytes; never commit a real secret
JIA_OTP_HMAC_SECRET=
